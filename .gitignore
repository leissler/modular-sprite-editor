# Project Specific
# (We exclude the build folders, but we keep the spec files and scripts)
# Generated Icons (Keep the pipeline source and final assets, but maybe not the intermediate iconset folder?)
# Actually, keeping assets/icon.ico and assets/icon.icns involves binary blobs but they are small and useful for the repo.
# We DO check in the assets.
Binpack/
.tmp_*/
test_output_dbg*/
safe_debug.txt

# SGDK example build artifacts
examples/sgdk/sgdk_demo/out/
examples/sgdk/sgdk_demo/third_party/sgdk/.git/
examples/sgdk/sgdk_demo/third_party/sgdk/out/
# SGDK's prebuilt libraries (libgcc.a, libmd.a, libmd_debug.a): Windows builds link them
!examples/sgdk/sgdk_demo/third_party/sgdk/lib/
examples/sgdk/sgdk_demo/third_party/sgdk/sample/**/out/

# Built website
website/site/

# Backups the editor keeps next to saved projects (name.json.bak)
*.json.bak

# PVSnesLib (the SNES toolchain, downloaded per platform; see examples/snes/README.md) and the demo's build output
# (the generated data, res/ms_chunk_NN.bin, modsprite_chunks.asm, modsprite_rom.mk and the C files, is kept)
examples/snes/snes_demo/third_party/
examples/snes/snes_demo/*.sfc
examples/snes/snes_demo/*.sym
examples/snes/snes_demo/*.symfull
examples/snes/snes_demo/hdr.asm
examples/snes/snes_demo/linkfile
examples/snes/snes_demo/build.log
examples/snes/snes_demo/src/main.asm
examples/snes/snes_demo/src/modsprite.asm
examples/snes/snes_demo/src/modsprite_data.asm
examples/snes/snes_demo/**/*.obj
examples/snes/snes_demo/**/*.ps
